# Shared defaults for scripts/delegate.sh.
# Precedence: CLI flags > environment variables > this file > built-in defaults.

# Model alias passed to `vibe --model`. Define aliases in your own ~/.vibe/config.toml
# ([[models]]); empty means Vibe's default routing.
DELEGATE_MODEL=

# Approve mode for headless runs:
#   smart = classifier auto-runs safe tool calls, risky ones are denied (default)
#   auto  = --auto-approve, approves every tool call (allowlists are bypassed)
#   ask   = fail-closed: anything needing approval is denied
DELEGATE_MODE=smart

# Optional Vibe agent profile (--agent NAME), e.g. a bounded profile from ~/.vibe/agents/.
DELEGATE_AGENT=

# Budget guards for programmatic mode (empty = flag omitted).
DELEGATE_MAX_TURNS=200
DELEGATE_MAX_PRICE=10
DELEGATE_MAX_TOKENS=
DELEGATE_TIME_LIMIT=3600

# vibe -p output format: text (default, final answer on stdout) or json (full export).
DELEGATE_OUTPUT=text

# Run log directory, relative to the project root unless absolute.
DELEGATE_LOG_DIR=.delegate
